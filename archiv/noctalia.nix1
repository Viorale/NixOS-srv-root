{
  inputs,
  pkgs,
  config,
  ...
}:

{
  imports = [ inputs.noctalia.homeModules.default ];

  programs.noctalia = {
    enable = true;
    # Kein systemd.enable: Niri startet Noctalia (sonst zwei Bars)
    settings = {
      shell.font_family = "CaskaydiaCove Nerd Font";
      shell.polkit_agent = true;

      # Wallpaper aus dem Repo – für alle User gleich (optional)
      wallpaper.directory = "${config.home.homeDirectory}/Bilder/Background";

      theme = {
        mode = "dark";
        source = "wallpaper"; # vorher: builtin Catppuccin
        templates = {
          enable_builtin_templates = true;
          builtin_ids = [
            "kitty"
            "gtk3"
            "gtk4"
          ];
          enable_community_templates = true;
          community_ids = [
            "zen-browser"
            "obsidian"
            "discord"
          ];
        };
      };
    };
  };

  # kitty: HM besitzt kitty.conf, Noctalia besitzt themes/noctalia.conf
  programs.kitty.extraConfig = "include themes/noctalia.conf";

  # GTK: gleiches Prinzip – gtk.css importiert Noctalias noctalia.css
  gtk = {
    enable = true;
    theme = {
      name = "adw-gtk3-dark";
      package = pkgs.adw-gtk3;
    };
    gtk3.extraCss = ''@import url("noctalia.css");'';
    gtk4.extraCss = ''@import url("noctalia.css");'';
  };
}
